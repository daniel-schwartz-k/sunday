<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <!-- Tinted rounded background -->
    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_bg"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Header: app logo + name + open app tap target -->
        <LinearLayout
            android:id="@+id/widget_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="6dp">

            <ImageView
                android:id="@+id/widget_header_logo"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_sunday_logo"
                android:layout_marginEnd="8dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/widget_header_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- Sync button / spinner area -->
            <FrameLayout
                android:id="@+id/widget_sync_area"
                android:layout_width="34dp"
                android:layout_height="30dp">

                <TextView
                    android:id="@+id/widget_sync_btn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="⇅"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:contentDescription="Sync" />

                <ProgressBar
                    android:id="@+id/widget_sync_progress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- Divider line -->
        <ImageView
            android:id="@+id/widget_header_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#3d3d3d"
            android:layout_marginBottom="4dp"
            android:contentDescription="@null" />

        <!-- ListView for tasks + section headers -->
        <ListView
            android:id="@+id/widget_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="vertical"
            android:background="@android:color/transparent"
            android:cacheColorHint="#00000000" />

        <!-- Empty view when no snapshot / no tasks -->
        <TextView
            android:id="@+id/widget_empty_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Open Sunday to load tasks"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
