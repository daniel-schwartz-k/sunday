# Playwright CLI output (may contain credentials)
.playwright-cli/

# Node / dependencies
node_modules/
package-lock.json.bak

# Capacitor web export output (generated by npm run build:web)
www/

# Android build outputs & local config (standard Android gitignore)
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/*.iml
android/app/*.iml

# Release signing keys (never commit secrets)
*.jks
*.keystore
release.jks
sunday-release.jks
